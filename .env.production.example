# Production environment template
# Copy to the host env (or .env.production) and fill every required value.
# Never commit real secrets.

# --- Site / Auth ---
# Public canonical origin (https, no trailing slash). Used by sitemap, robots, OG, Absolute URLs.
NEXT_PUBLIC_SITE_URL=https://kavcomexpert.com
# Better Auth base URL (usually same as site URL)
BETTER_AUTH_URL=https://kavcomexpert.com
# Long random secret (>= 32 chars). Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Database (Neon Postgres) ---
# Production branch connection string. Do not point at a *-dev / preview branch.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# --- Cloudflare R2 (media uploads) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public CDN/base URL for objects (https://...). Used by next/image remotePatterns.
R2_PUBLIC_URL=https://media.example.com

# --- Email (Resend) ---
RESEND_API_KEY=
# From address verified in Resend
RESEND_FROM_EMAIL=noreply@kavcomexpert.com
# Inbox for lead notifications (optional; falls back to site settings contact email)
LEAD_NOTIFY_EMAIL=

# --- IndexNow ---
INDEXNOW_KEY=

# --- Analytics (optional; also configurable in Admin → Settings) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=

# --- Google service account (optional: Search Console / future SEO tooling) ---
# JSON key contents or path depending on your host; keep secret.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- Cron / internal jobs ---
# Shared secret for protected cron routes (Authorization: Bearer …)
CRON_SECRET=

# --- Cloudflare Turnstile (optional bot protection for public lead forms) ---
# Create a widget in the Cloudflare dashboard; list staging + production hostnames.
# If either key is empty, Turnstile is silently disabled (forms behave as before).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Invite email domain (default company restriction) ---
# Invites must match this domain unless admin checks “Allow external email”.
INVITE_EMAIL_DOMAIN=kavcomexpert.com

# --- Node ---
NODE_ENV=production
PORT=3000
